{
  "extends": [
    "plugin:react-hooks/recommended",
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "plugins": ["react"],
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module",
    "ecmaFeatures": {
      "modules": true,
      "classes": true,
      "tsx": true
    }
  },
  "rules": {
    "semi": [2, "always"],
    "no-var": "error",
    "no-empty-function": "error",
    "prefer-const": "error",
    "curly": [2, "all"],
    "no-restricted-syntax": [
      "error",
      {
        "selector": ":matches(ImportNamespaceSpecifier, ExportAllDeclaration, ExportNamespaceSpecifier)",
        "message": "Import/export only modules you need"
      }
    ],
    "max-depth": ["error", 3],
    "no-shadow": [
      "error",
      { "builtinGlobals": false, "hoist": "functions", "allow": [] }
    ]
  },
  "overrides": [
    {
      "files": ["*.jsx", "*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "rules": {
        "no-use-before-define": "off",
        "react/self-closing-comp": "off",
        "react/jsx-closing-bracket-location": "off",
        "react/jsx-handler-names": "off",
        "react/jsx-closing-tag-location": "off",
        "react/jsx-indent": "off",
        "no-undef": "off"
      }
    }
  ],
  "env": {
    "es6": true,
    "browser": true,
    "node": true,
    "jest": true
  },
  "globals": {
    "React": true,
    "localStorage": true,
    "document": true,
    "clearTimeout": true,
    "setTimeout": true
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    },
    "react": {
      "version": "detect"
    }
  }
}
